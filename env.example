# Configuración de Los Cocos E-commerce
# Copia este archivo a .env y modifica los valores según tus necesidades

# === CONFIGURACIÓN DE BASE DE DATOS ===
MYSQL_DATABASE=loscocos_wp
MYSQL_USER=loscocos_user
MYSQL_PASSWORD=loscocos_2024
MYSQL_ROOT_PASSWORD=root_password_2024

# === CONFIGURACIÓN DE WORDPRESS ===
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_NAME=loscocos_wp
WORDPRESS_DB_USER=loscocos_user
WORDPRESS_DB_PASSWORD=loscocos_2024
WORDPRESS_TABLE_PREFIX=wp_

# Configuración de WordPress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=loscocos2024
WP_ADMIN_EMAIL=admin@loscocos.local
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=Vivero Los Cocos

# === CONFIGURACIÓN DE PUERTOS ===
# Cambia estos puertos si ya están en uso en tu sistema
NGINX_PORT=8080
NGINX_SSL_PORT=8443
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

# === CONFIGURACIÓN DE DESARROLLO ===
# Activar modo debug (true/false)
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_LOG=true
WORDPRESS_DEBUG_DISPLAY=true

# === CONFIGURACIÓN DE WOOCOMMERCE ===
WC_DEFAULT_COUNTRY=AR
WC_CURRENCY=ARS
WC_CURRENCY_POSITION=left_space
WC_THOUSAND_SEPARATOR=.
WC_DECIMAL_SEPARATOR=,
WC_DECIMAL_PLACES=0

# === CONFIGURACIÓN DE EMPRESA ===
COMPANY_NAME=Vivero Los Cocos
COMPANY_DESCRIPTION=Tu oasis verde en Mendoza
COMPANY_ADDRESS=Av. San Martín 1234, Mendoza, Argentina
COMPANY_PHONE=+54 261 456-7890
COMPANY_EMAIL=contacto@loscocos.com.ar
COMPANY_WHATSAPP=+54 261 123-4567

# === CONFIGURACIÓN DE REDES SOCIALES ===
INSTAGRAM_URL=https://www.instagram.com/viveroloscocos/
FACEBOOK_URL=https://www.facebook.com/viveroloscocos
TWITTER_URL=https://www.twitter.com/viveroloscocos

# === CONFIGURACIÓN DE TIMEZONE ===
TIMEZONE=America/Argentina/Mendoza

# === CONFIGURACIÓN DE IDIOMA ===
WORDPRESS_LOCALE=es_ES
WP_LANGUAGE=es_ES

# === CONFIGURACIÓN DE SEGURIDAD ===
# Genera nuevas claves en: https://api.wordpress.org/secret-key/1.1/salt/
WP_AUTH_KEY=pon-tu-clave-unica-aqui
WP_SECURE_AUTH_KEY=pon-tu-clave-unica-aqui
WP_LOGGED_IN_KEY=pon-tu-clave-unica-aqui
WP_NONCE_KEY=pon-tu-clave-unica-aqui
WP_AUTH_SALT=pon-tu-clave-unica-aqui
WP_SECURE_AUTH_SALT=pon-tu-clave-unica-aqui
WP_LOGGED_IN_SALT=pon-tu-clave-unica-aqui
WP_NONCE_SALT=pon-tu-clave-unica-aqui

# === CONFIGURACIÓN DE EMAIL ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-password-de-aplicacion
SMTP_FROM_EMAIL=noreply@loscocos.local
SMTP_FROM_NAME=Vivero Los Cocos

# === CONFIGURACIÓN DE BACKUP ===
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# === CONFIGURACIÓN DE PERFORMANCE ===
WP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=3000
PHP_POST_MAX_SIZE=64M
PHP_UPLOAD_MAX_FILESIZE=64M 