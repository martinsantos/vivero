// Crear productos de ejemplo
function loscocos_create_sample_products() {
    if (!class_exists('WooCommerce') || get_option('loscocos_products_created')) {
        return;
    }
    
    $products = array(
        array(
            'name' => 'Rosa Perfumada',
            'price' => '1500',
            'description' => 'Hermosa rosa perfumada ideal para jardines románticos.',
        ),
        array(
            'name' => 'Cactus Decorativo',
            'price' => '800',
            'description' => 'Cactus resistente perfecto para espacios interiores.',
        ),
        array(
            'name' => 'Planta de Interior',
            'price' => '1200',
            'description' => 'Planta ideal para decorar tu hogar con estilo.',
        ),
        array(
            'name' => 'Planta de Exterior',
            'price' => '2000',
            'description' => 'Planta resistente para jardines y patios.',
        )
    );
    
    foreach ($products as $product_data) {
        $product = new WC_Product_Simple();
        $product->set_name($product_data['name']);
        $product->set_regular_price($product_data['price']);
        $product->set_description($product_data['description']);
        $product->set_short_description(substr($product_data['description'], 0, 50) . '...');
        $product->set_status('publish');
        $product->set_featured(true);
        $product->save();
    }
    
    update_option('loscocos_products_created', true);
}
add_action('wp_loaded', 'loscocos_create_sample_products');

// Forzar el uso del template single-product para productos individuales
function loscocos_force_single_product_template($template) {
    global $wp_query;
    
    // Si es una consulta de producto individual estándar de WooCommerce
    if (is_singular('product')) {
        // Buscar el template single-product.php en el tema
        $single_product_template = locate_template('single-product.php');
        if ($single_product_template) {
            return $single_product_template;
        }
        
        // Si no existe, buscar en woocommerce/single-product.php
        $woo_single_template = locate_template('woocommerce/single-product.php');
        if ($woo_single_template) {
            return $woo_single_template;
        }
    }
    
    // También manejar URLs personalizadas para compatibilidad
    if (isset($_GET['product']) && !empty($_GET['product'])) {
        $product_slug = sanitize_text_field($_GET['product']);
        
        // Buscar el producto por slug
        $product_post = get_page_by_path($product_slug, OBJECT, 'product');
        
        if ($product_post) {
            // Configurar la consulta global para este producto
            $wp_query->is_single = true;
            $wp_query->is_singular = true;
            $wp_query->is_home = false;
            $wp_query->is_archive = false;
            $wp_query->is_category = false;
            $wp_query->is_shop = false;
            
            // Establecer el post actual
            global $post;
            $post = $product_post;
            setup_postdata($post);
            
            // Buscar el template single-product.php
            $single_product_template = locate_template('single-product.php');
            if ($single_product_template) {
                return $single_product_template;
            }
        }
    }
    
    return $template;
}
add_filter('template_include', 'loscocos_force_single_product_template', 99);

// Sistema de imágenes personalizadas por producto - VERSIÓN MEJORADA 2024
function loscocos_get_product_image($product_id, $size = 'large') {
    $product = wc_get_product($product_id);
    if (!$product) return '';
    
    $product_name = strtolower($product->get_name());
    $product_sku = strtolower($product->get_sku());
    $categories = wp_get_post_terms($product_id, 'product_cat');
    $category_slug = '';
    
    if ($categories && !is_wp_error($categories)) {
        $category_slug = $categories[0]->slug;
    }
    
    // Generar hash único basado en ID + nombre para variedad
    $unique_hash = md5($product_id . $product_name . $product_sku);
    $image_variant = hexdec(substr($unique_hash, 0, 2)) % 10; // 0-9
    
    // Mapeo específico de productos con imágenes ultra-específicas para vivero
    $product_images = array(
        // PLANTAS DE INTERIOR - Especies reales de interior populares en Argentina
        'plantas-de-interior' => array(
            0 => 'https://images.unsplash.com/photo-1463320726281-696a485928c7?w=800&h=600&fit=crop&q=95', // Pothos dorado clásico
