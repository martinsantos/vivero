// FILTRO ULTRA AGRESIVO - FORZAR EN TODOS LOS CONTEXTOS DEL CARRITO
// function loscocos_force_all_cart_images($image, $product_id = null, $size = null, $attr = null, $placeholder = null, $image_size = null) {
    // Detectar si estamos en contexto de carrito
    $is_cart_context = (
        is_cart() || 
        (isset($_SERVER['REQUEST_URI']) && strpos($_SERVER['REQUEST_URI'], '/cart') !== false) ||
        (defined('DOING_AJAX') && DOING_AJAX) ||
        (isset($_POST['action']) && in_array($_POST['action'], ['woocommerce_add_to_cart', 'woocommerce_get_refreshed_fragments']))
    );
    
    if ($is_cart_context && $product_id) {
        // SIEMPRE usar nuestra imagen personalizada en el carrito
        return loscocos_get_cart_product_image($product_id, $size ?: 'woocommerce_thumbnail');
    }
    
    return $image;
}

