<?php
/**
 * Functions para Vivero Los Cocos con WooCommerce
 */

// Evitar acceso directo
if (!defined('ABSPATH')) {
    exit;
}

// Configuración básica del tema
function loscocos_theme_setup() {
    // Soporte para WooCommerce
    add_theme_support('woocommerce');
    add_theme_support('wc-product-gallery-zoom');
    add_theme_support('wc-product-gallery-lightbox');
    add_theme_support('wc-product-gallery-slider');
    
    // Soporte básico de WordPress
    add_theme_support('title-tag');
    add_theme_support('post-thumbnails');
    
    // Soporte para HTML5
    add_theme_support('html5', array(
        'search-form',
        'comment-form',
        'comment-list',
        'gallery',
        'caption',
    ));
}
add_action('after_setup_theme', 'loscocos_theme_setup');

// Cargar estilos y scripts
function loscocos_scripts() {
    wp_enqueue_style('loscocos-style', get_stylesheet_uri(), array(), '6.0.2');
    
    // Cargar Google Fonts exactas del home.html
    wp_enqueue_style('google-fonts', 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&display=swap', array(), null);
    
    // Cargar Tailwind CSS CDN - IGUAL QUE HOME.HTML
    wp_enqueue_script('tailwind-cdn', 'https://cdn.tailwindcss.com?plugins=forms,container-queries', array(), null, false);
    
    // Solo cargar scripts de WooCommerce si está activo
    if (class_exists('WooCommerce')) {
        wp_enqueue_script('wc-cart-fragments');
        wp_enqueue_script('wc-add-to-cart');
    }
    
    // Localizar script para AJAX
    wp_localize_script('wc-cart-fragments', 'loscocos_ajax', array(
        'ajax_url' => admin_url('admin-ajax.php'),
        'nonce' => wp_create_nonce('ajax_nonce'),
        'add_to_cart_nonce' => wp_create_nonce('add_to_cart_nonce')
    ));
}
add_action('wp_enqueue_scripts', 'loscocos_scripts');

// Configuración específica para Argentina
function loscocos_woocommerce_config() {
    // Configurar moneda
    add_filter('woocommerce_currency', function() { return 'ARS'; });
    
    // Configurar formato de precio
    add_filter('woocommerce_price_format', function() { return '%1$s %2$s'; });
    
    // Configurar país por defecto
    add_filter('default_option_woocommerce_default_country', function() { return 'AR:B'; });
}
add_action('init', 'loscocos_woocommerce_config');

// Configurar páginas de WooCommerce automáticamente
function loscocos_setup_woocommerce_pages() {
    if (!class_exists('WooCommerce') || get_option('loscocos_woo_pages_created')) {
        return;
    }
    
    // Función para crear página si no existe
    $create_page = function($slug, $title, $shortcode = '') {
        $page = get_page_by_path($slug);
        if (!$page) {
            $page_data = array(
                'post_title'    => $title,
                'post_content'  => $shortcode ? '[' . $shortcode . ']' : '',
                'post_status'   => 'publish',
                'post_type'     => 'page',
                'post_name'     => $slug,
                'post_author'   => 1,
                'comment_status' => 'closed'
            );
            return wp_insert_post($page_data);
        }
        return $page->ID;
    };
    
    // Crear páginas necesarias
    $cart_id = $create_page('cart', 'Carrito', 'woocommerce_cart');
    $checkout_id = $create_page('checkout', 'Finalizar Compra', 'woocommerce_checkout');
    $account_id = $create_page('my-account', 'Mi Cuenta', 'woocommerce_my_account');
    $shop_id = $create_page('shop', 'Tienda', 'woocommerce_shop');
    
    // Configurar opciones de WooCommerce
    if ($cart_id) {
        update_option('woocommerce_cart_page_id', $cart_id);
    }
    if ($checkout_id) {
        update_option('woocommerce_checkout_page_id', $checkout_id);
    }
    if ($account_id) {
        update_option('woocommerce_myaccount_page_id', $account_id);
    }
    if ($shop_id) {
        update_option('woocommerce_shop_page_id', $shop_id);
    }
    
    // Configurar moneda y formato
    update_option('woocommerce_currency', 'ARS');
    update_option('woocommerce_currency_pos', 'left_space');
    update_option('woocommerce_price_thousand_sep', '.');
    update_option('woocommerce_price_decimal_sep', ',');
    update_option('woocommerce_price_num_decimals', 0);
    
    // Marcar como completado
    update_option('loscocos_woo_pages_created', true);
    
    // Regenerar reglas de reescritura
    flush_rewrite_rules();
}
add_action('wp_loaded', 'loscocos_setup_woocommerce_pages');

// Asegurar que las imágenes de productos se muestren en el carrito
// function loscocos_fix_cart_images() {
    // Habilitar soporte para miniaturas de posts
    add_theme_support('post-thumbnails');
    
    // Agregar tamaños de imagen específicos para WooCommerce si no existen
    if (!has_image_size('woocommerce_thumbnail')) {
        add_image_size('woocommerce_thumbnail', 300, 300, true);
    }
    if (!has_image_size('woocommerce_single')) {
        add_image_size('woocommerce_single', 600, 600, true);
    }
    if (!has_image_size('woocommerce_gallery_thumbnail')) {
        add_image_size('woocommerce_gallery_thumbnail', 100, 100, true);
    }
}
add_action('after_setup_theme', 'loscocos_fix_cart_images');

// Función personalizada para obtener imagen de producto en el carrito - VERSIÓN MEJORADA
// function loscocos_get_cart_product_image($product_id, $size = 'woocommerce_thumbnail') {
    $product = wc_get_product($product_id);
    $product_name = $product ? $product->get_name() : 'Planta';
    
    // Intentar obtener imagen real primero
    if ($product && $product->get_image_id()) {
        $image_url = wp_get_attachment_image_url($product->get_image_id(), $size);
        if ($image_url) {
            return '<img src="' . esc_url($image_url) . '" alt="' . esc_attr($product_name) . '" style="width: 120px !important; height: 120px !important; object-fit: cover !important; border-radius: 8px !important;" />';
        }
    }
    
    // Buscar imagen SVG personalizada
    $upload_dir = wp_upload_dir();
    $svg_paths = [
        $upload_dir['basedir'] . '/2025/06/' . sanitize_file_name($product_name) . '.svg',
        $upload_dir['basedir'] . '/2025/01/' . sanitize_file_name($product_name) . '.svg',
        get_template_directory() . '/images/' . sanitize_file_name($product_name) . '.svg'
    ];
    
    foreach ($svg_paths as $svg_path) {
        if (file_exists($svg_path)) {
            $svg_url = str_replace($upload_dir['basedir'], $upload_dir['baseurl'], $svg_path);
            return '<img src="' . esc_url($svg_url) . '" alt="' . esc_attr($product_name) . '" style="width: 120px !important; height: 120px !important; object-fit: cover !important; border-radius: 8px !important;" />';
        }
    }
    
    // Generar SVG inline como último recurso
    $short_name = wp_trim_words($product_name, 2, '');
    $category = '';
    
    if ($product) {
        $terms = get_the_terms($product_id, 'product_cat');
        if ($terms && !is_wp_error($terms)) {
            $category = $terms[0]->name;
        }
    }
    
    $svg_content = '<svg width="120" height="120" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" style="border-radius: 8px;">
        <defs>
            <linearGradient id="grad' . $product_id . '" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
                <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
            </linearGradient>
        </defs>
        <rect width="120" height="120" fill="url(#grad' . $product_id . ')" />
        <text x="60" y="45" font-family="Arial, sans-serif" font-size="24" fill="white" text-anchor="middle">🌱</text>
        <text x="60" y="65" font-family="Arial, sans-serif" font-size="10" fill="white" text-anchor="middle">' . esc_html($short_name) . '</text>
        <text x="60" y="80" font-family="Arial, sans-serif" font-size="8" fill="rgba(255,255,255,0.8)" text-anchor="middle">' . esc_html($category) . '</text>
        <circle cx="100" cy="20" r="8" fill="#047857" />
        <text x="100" y="25" font-family="Arial, sans-serif" font-size="10" fill="white" text-anchor="middle">✓</text>
    </svg>';
    
    return $svg_content;
}

