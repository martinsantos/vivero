    // Seleccionar imagen basada en categoría y variante única
    if (isset($product_images[$category_slug])) {
        $category_images = $product_images[$category_slug];
        return $category_images[$image_variant];
    }
    
    // Fallback a categoría por defecto
    $default_images = $product_images['default'];
    return $default_images[$image_variant];
}

// AJAX para agregar productos al carrito
add_action('wp_ajax_add_to_cart', 'ajax_add_to_cart');
add_action('wp_ajax_nopriv_add_to_cart', 'ajax_add_to_cart');

function ajax_add_to_cart() {
    // Verificar que WooCommerce esté activo
    if (!function_exists('WC')) {
        wp_send_json_error('WooCommerce no está activo');
        return;
    }
    
    // Verificar nonce si está presente
    if (isset($_POST['nonce']) && !wp_verify_nonce($_POST['nonce'], 'add_to_cart_nonce')) {
        wp_send_json_error('Nonce verification failed');
        return;
    }
    
    $product_id = intval($_POST['product_id']);
    $quantity = intval($_POST['quantity']) ?: 1;
    
    // Verificar que el producto existe
    $product = wc_get_product($product_id);
    if (!$product) {
        wp_send_json_error('Producto no encontrado');
        return;
    }
    
    // Verificar que el producto está en stock
    if (!$product->is_in_stock()) {
        wp_send_json_error('Producto agotado');
        return;
    }
    
    // Agregar producto al carrito
    $cart_item_key = WC()->cart->add_to_cart($product_id, $quantity);
    
    if ($cart_item_key) {
        wp_send_json_success(array(
            'message' => 'Producto agregado al carrito',
            'cart_count' => WC()->cart->get_cart_contents_count(),
            'cart_item_key' => $cart_item_key,
            'product_name' => $product->get_name(),
            'cart_total' => WC()->cart->get_cart_total()
        ));
    } else {
        wp_send_json_error('No se pudo agregar el producto al carrito');
    }
}

// AJAX para obtener el contador del carrito
add_action('wp_ajax_get_cart_count', 'ajax_get_cart_count');
add_action('wp_ajax_nopriv_get_cart_count', 'ajax_get_cart_count');

function ajax_get_cart_count() {
    // Verificar nonce
    if (!wp_verify_nonce($_POST['nonce'], 'cart_count_nonce')) {
        wp_die('Nonce verification failed');
    }
    
    if (!function_exists('WC')) {
        wp_send_json_error('WooCommerce no está activo');
        return;
    }
    
    wp_send_json_success(array(
        'count' => WC()->cart->get_cart_contents_count()
    ));
}

// AJAX para búsqueda de productos
add_action('wp_ajax_search_products', 'ajax_search_products');
add_action('wp_ajax_nopriv_search_products', 'ajax_search_products');

function ajax_search_products() {
    // Verificar nonce
    if (!wp_verify_nonce($_POST['nonce'], 'search_products_nonce')) {
        wp_die('Nonce verification failed');
    }
    
    $search_term = sanitize_text_field($_POST['search_term']);
    $category = sanitize_text_field($_POST['category']);
    $page = intval($_POST['page']) ?: 1;
    $per_page = 12;
    
    // Construir query
    $args = array(
        'post_type' => 'product',
        'posts_per_page' => $per_page,
        'paged' => $page,
        'post_status' => 'publish',
        'orderby' => 'relevance',
        'order' => 'DESC'
    );
    
    // Agregar búsqueda por texto
    if (!empty($search_term)) {
        $args['s'] = $search_term;
    }
    
    // Agregar filtro por categoría
    if (!empty($category) && $category !== 'all') {
        $args['tax_query'] = array(
            array(
                'taxonomy' => 'product_cat',
                'field' => 'slug',
                'terms' => $category,
            ),
        );
    }
    
    $products_query = new WP_Query($args);
    $products_html = '';
    
    if ($products_query->have_posts()) {
        while ($products_query->have_posts()) {
            $products_query->the_post();
            global $product;
            if (!$product) {
                $product = wc_get_product(get_the_ID());
            }
            
            if ($product) {
                $image_url = loscocos_get_product_image($product->get_id());
                $categories = wp_get_post_terms($product->get_id(), 'product_cat');
                $category_slugs = array();
                if ($categories && !is_wp_error($categories)) {
                    foreach ($categories as $cat) {
                        $category_slugs[] = $cat->slug;
                    }
                }
                $category_classes = implode(' ', $category_slugs);
                $product_url = get_permalink($product->get_id());
                
                // Determinar etiqueta del producto
                $product_label = '';
                $label_class = '';
                if ($product->is_on_sale()) {
                    $product_label = 'OFERTA';
                    $label_class = 'oferta';
                } elseif ($product->is_featured()) {
                    $product_label = 'DESTACADO';
                    $label_class = 'destacado';
                } elseif (!$product->is_in_stock()) {
                    $product_label = 'AGOTADO';
                    $label_class = 'agotado';
                } else {
                    $seasonal_cats = array('plantas-de-interior', 'arboles', 'arbustos');
                    $is_seasonal = false;
                    foreach ($category_slugs as $slug) {
                        if (in_array($slug, $seasonal_cats)) {
                            $is_seasonal = true;
                            break;
                        }
                    }
                    if ($is_seasonal) {
                        $product_label = 'TEMPORADA';
                        $label_class = 'temporada';
                    } else {
                        $product_label = 'DISPONIBLE';
                        $label_class = 'disponible';
                    }
                }
                
                $products_html .= '<div class="product-card" data-categories="' . $category_classes . '" onclick="window.location.href=\'' . $product_url . '\'">';
                $products_html .= '<div class="product-image">';
                $products_html .= '<img alt="' . esc_attr($product->get_name()) . '" src="' . esc_url($image_url) . '"/>';
                $products_html .= '<div class="product-label ' . $label_class . '">' . $product_label . '</div>';
                $products_html .= '</div>';
                $products_html .= '<div class="product-content">';
                $products_html .= '<h3 class="product-title">' . esc_html($product->get_name()) . '</h3>';
                
                if ($categories && !is_wp_error($categories)) {
                    $products_html .= '<p class="product-category">' . esc_html($categories[0]->name) . '</p>';
                }
                
                $products_html .= '<div class="product-footer">';
                $products_html .= '<span class="product-price">$' . number_format($product->get_price(), 0, ',', '.') . '</span>';
                if ($product->is_in_stock()) {
                    $products_html .= '<button class="add-to-cart-btn" onclick="event.stopPropagation(); addToCart(' . $product->get_id() . ')">';
                    $products_html .= '<span class="material-icons" style="font-size: 1rem;">add_shopping_cart</span> Añadir';
                    $products_html .= '</button>';
                } else {
                    $products_html .= '<button class="add-to-cart-btn" disabled>';
                    $products_html .= '<span class="material-icons" style="font-size: 1rem;">block</span> Agotado';
                    $products_html .= '</button>';
                }
                $products_html .= '</div>';
                $products_html .= '</div>';
                $products_html .= '</div>';
            }
        }
        wp_reset_postdata();
    }
    
    wp_send_json_success(array(
        'products_html' => $products_html,
        'found_posts' => $products_query->found_posts,
        'max_pages' => $products_query->max_num_pages,
        'current_page' => $page
    ));
}

// AJAX para quick add to cart
add_action('wp_ajax_add_to_cart_quick', 'ajax_add_to_cart_quick');
add_action('wp_ajax_nopriv_add_to_cart_quick', 'ajax_add_to_cart_quick');

function ajax_add_to_cart_quick() {
    if (!function_exists('WC')) {
        wp_send_json_error('WooCommerce no está activo');
        return;
    }
    
    $product_id = intval($_POST['product_id']);
    $quantity = intval($_POST['quantity']) ?: 1;
    
    if ($product_id > 0) {
        $product = wc_get_product($product_id);
        if (!$product) {
            wp_send_json_error('Producto no encontrado');
            return;
        }
        
        $added = WC()->cart->add_to_cart($product_id, $quantity);
        
        if ($added) {
            wp_send_json_success(array(
                'message' => 'Producto agregado al carrito: ' . $product->get_name(),
                'cart_count' => WC()->cart->get_cart_contents_count()
            ));
        } else {
            wp_send_json_error('Error al agregar producto');
        }
    } else {
        wp_send_json_error('ID de producto inválido');
    }
}

// Funciones AJAX para el carrito - VERSIÓN CORREGIDA
add_action('wp_ajax_update_cart_quantity', 'handle_update_cart_quantity');
add_action('wp_ajax_nopriv_update_cart_quantity', 'handle_update_cart_quantity');

function handle_update_cart_quantity() {
    // Log para debugging
    error_log('🔄 AJAX update_cart_quantity iniciado');
    
    // Verificar que es una petición POST
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
        error_log('❌ No es POST request');
        wp_send_json_error('Método no permitido');
        return;
    }
    
    // Verificar nonce
    $nonce = isset($_POST['nonce']) ? $_POST['nonce'] : '';
    if (!wp_verify_nonce($nonce, 'cart_nonce')) {
        error_log('❌ Nonce inválido. Recibido: ' . $nonce);
        wp_send_json_error('Nonce inválido');
        return;
    }
    
    // Obtener parámetros
    $cart_key = isset($_POST['cart_key']) ? sanitize_text_field($_POST['cart_key']) : '';
    $quantity = isset($_POST['quantity']) ? intval($_POST['quantity']) : 0;
    
    error_log('📦 Cart key: ' . $cart_key . ', Quantity: ' . $quantity);
    
    if (empty($cart_key)) {
        error_log('❌ Cart key vacío');
        wp_send_json_error('Cart key requerido');
        return;
    }
    
    if ($quantity < 1) {
        error_log('❌ Cantidad inválida: ' . $quantity);
        wp_send_json_error('Cantidad debe ser mayor a 0');
        return;
    }
    
    // Verificar que WooCommerce esté disponible
    if (!class_exists('WooCommerce') || !WC() || !WC()->cart) {
        error_log('❌ WooCommerce no disponible');
        wp_send_json_error('WooCommerce no disponible');
        return;
    }
    
    // Verificar que el cart key existe
    $cart_contents = WC()->cart->get_cart();
    if (!isset($cart_contents[$cart_key])) {
        error_log('❌ Cart key no existe en el carrito: ' . $cart_key);
        wp_send_json_error('Producto no encontrado en el carrito');
        return;
    }
    
    try {
        // Actualizar cantidad
        $result = WC()->cart->set_quantity($cart_key, $quantity, true);
        
        if ($result) {
            // Recalcular totales
            WC()->cart->calculate_totals();
            
            error_log('✅ Cantidad actualizada correctamente');
            
            wp_send_json_success(array(
                'message' => 'Cantidad actualizada correctamente',
                'cart_key' => $cart_key,
                'quantity' => $quantity,
                'total' => WC()->cart->get_total(),
                'subtotal' => WC()->cart->get_cart_subtotal(),
                'count' => WC()->cart->get_cart_contents_count(),
                'cart_hash' => WC()->cart->get_cart_hash()
            ));
        } else {
            error_log('❌ Error en WC()->cart->set_quantity()');
            wp_send_json_error('Error actualizando cantidad en WooCommerce');
        }
    } catch (Exception $e) {
        error_log('❌ Excepción: ' . $e->getMessage());
        wp_send_json_error('Error interno: ' . $e->getMessage());
    }
}

add_action('wp_ajax_remove_cart_item', 'handle_remove_cart_item');
add_action('wp_ajax_nopriv_remove_cart_item', 'handle_remove_cart_item');

function handle_remove_cart_item() {
    error_log('🗑️ AJAX remove_cart_item iniciado');
    
    // Verificar que es una petición POST
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
        wp_send_json_error('Método no permitido');
        return;
    }
    
    // Verificar nonce
    $nonce = isset($_POST['nonce']) ? $_POST['nonce'] : '';
    if (!wp_verify_nonce($nonce, 'cart_nonce')) {
        error_log('❌ Nonce inválido para eliminar. Recibido: ' . $nonce);
        wp_send_json_error('Nonce inválido');
        return;
    }
    
    $cart_key = isset($_POST['cart_key']) ? sanitize_text_field($_POST['cart_key']) : '';
    
    if (empty($cart_key)) {
        wp_send_json_error('Cart key requerido');
        return;
    }
    
    error_log('🗑️ Eliminando cart key: ' . $cart_key);
    
    // Verificar que WooCommerce esté disponible
    if (!class_exists('WooCommerce') || !WC() || !WC()->cart) {
        wp_send_json_error('WooCommerce no disponible');
        return;
    }
    
    try {
        // Eliminar producto del carrito
        $result = WC()->cart->remove_cart_item($cart_key);
        
        if ($result) {
            // Recalcular totales
            WC()->cart->calculate_totals();
            
            error_log('✅ Producto eliminado correctamente');
            
            wp_send_json_success(array(
                'message' => 'Producto eliminado correctamente',
                'cart_key' => $cart_key,
                'total' => WC()->cart->get_total(),
                'subtotal' => WC()->cart->get_cart_subtotal(),
                'count' => WC()->cart->get_cart_contents_count(),
                'cart_hash' => WC()->cart->get_cart_hash()
            ));
        } else {
            error_log('❌ Error en WC()->cart->remove_cart_item()');
            wp_send_json_error('Error eliminando producto del carrito');
        }
    } catch (Exception $e) {
        error_log('❌ Excepción eliminando: ' . $e->getMessage());
        wp_send_json_error('Error interno: ' . $e->getMessage());
    }
} 