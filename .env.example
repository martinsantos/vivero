# WordPress / WooCommerce
WORDPRESS_URL=http://localhost:8080
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# WordPress media upload auth (Application Passwords)
# In WP Admin: Users > Profile > Application Passwords > Add New
WP_USERNAME=
WP_APP_PASSWORD=

# Image provider API keys
UNSPLASH_API_KEY=
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Notes:
# - Do NOT commit your real .env to version control.
# - This file is an example; copy to .env and fill values.
