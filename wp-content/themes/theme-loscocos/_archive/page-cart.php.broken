                                <?php
                                // --- SOLUCIÓN SIMPLE PARA IMÁGENES ---
                                $product = $cart_item['data'];
                                
                                // Intentar obtener imagen estándar de WooCommerce
                                $thumbnail = $product->get_image('woocommerce_thumbnail', array(
