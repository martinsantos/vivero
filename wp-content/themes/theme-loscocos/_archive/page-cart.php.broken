                            width: 100% !important;
                            box-sizing: border-box !important;
                            align-items: center !important;
                            gap: 24px !important;
                        " data-key="<?php echo esc_attr($cart_item_key); ?>">
                            
                            <!-- IMAGEN DEL PRODUCTO -->
