<script>
// ===== CARRITO LOS COCOS - JAVASCRIPT MEJORADO v2 =====
// Variables globales
const AJAX_URL = '<?php echo admin_url("admin-ajax.php"); ?>';
const CART_NONCE = '<?php echo wp_create_nonce("cart_nonce"); ?>';

console.log('🚀 Carrito Los Cocos iniciado');
console.log('🔑 AJAX_URL:', AJAX_URL);
console.log('🔐 CART_NONCE:', CART_NONCE);

// Función SUPER ROBUSTA para actualizar cantidad
function updateQuantity(cartKey, change) {
    console.log('🔄 updateQuantity iniciado:', cartKey, 'cambio:', change);
    
    // Verificar variables globales PRIMERO
    if (!AJAX_URL || !CART_NONCE) {
        console.error('❌ Variables globales no disponibles:', {AJAX_URL, CART_NONCE});
        alert('Error: Configuración AJAX no disponible');
        return;
    }
    
    // Buscar el elemento de cantidad con el selector específico y único
    const quantityElement = document.querySelector(`[data-key="${cartKey}"] .cart-item-qty`);
    
    if (!quantityElement) {
        console.error('❌ No se encontró elemento de cantidad con selector .cart-item-qty para:', cartKey);
        alert('Error CRÍTICO: No se encontró el elemento de cantidad. Contactar a soporte.');
        return;
    }
    
    // Limpiar el contenido antes de parsear para evitar NaN
    const qtyText = quantityElement.textContent.trim();
    console.log(`🔍 Texto de cantidad encontrado: "${qtyText}"`);
    const currentQty = parseInt(qtyText, 10);
    
    if (isNaN(currentQty)) {
        console.error('❌ Error de parseo a número (NaN) para el texto:', qtyText);
        alert('Error: La cantidad actual no es un número válido.');
        return;
    }

    const newQty = Math.max(1, currentQty + change);
    
    console.log('📊 Cantidad:', currentQty, '->', newQty);
    
    // Actualizar visualmente INMEDIATAMENTE
    quantityElement.textContent = newQty;
    quantityElement.style.background = '#fbbf24';
    quantityElement.style.color = 'white';
    
    // Deshabilitar botones temporalmente
    const allButtons = document.querySelectorAll(`[data-key="${cartKey}"] button`);
    allButtons.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.style.cursor = 'wait';
    });
    
    // Mostrar notificación inmediata
    showNotification('🔄 Actualizando cantidad...', 'info');
    
    // Preparar datos AJAX
    const formData = new FormData();
    formData.append('action', 'update_cart_quantity');
    formData.append('cart_key', cartKey);
    formData.append('quantity', newQty);
    formData.append('nonce', CART_NONCE);
    
    console.log('📤 Enviando datos AJAX:', {
        action: 'update_cart_quantity',
        cart_key: cartKey,
        quantity: newQty,
        nonce: CART_NONCE
    });
    
    // Enviar petición AJAX con timeout
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 segundos timeout
    
    fetch(AJAX_URL, {
        method: 'POST',
        body: formData,
        signal: controller.signal
    })
    .then(response => {
        clearTimeout(timeoutId);
        console.log('📡 Respuesta recibida:', response.status, response.statusText);
        
        if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }
        
        return response.text();
    })
    .then(text => {
        console.log('📄 Respuesta texto (primeros 200 chars):', text.substring(0, 200));
        
        let data;
        try {
            data = JSON.parse(text);
        } catch (parseError) {
            console.error('❌ Error parseando JSON:', parseError);
            console.log('📄 Texto completo:', text);
            throw new Error('Respuesta no es JSON válido');
        }
        
        console.log('📦 Datos parseados:', data);
        
        if (data.success) {
            console.log('✅ Cantidad actualizada correctamente en el servidor');
            
            // Restaurar estilo normal
            quantityElement.style.background = '#f9fafb';
            quantityElement.style.color = '#1f2937';
            
            showNotification('✅ Cantidad actualizada correctamente', 'success');
            
            // Actualizar contador del carrito si existe
            if (data.data && data.data.count !== undefined) {
                const cartCount = document.querySelector('.cart-count');
                if (cartCount) {
                    cartCount.textContent = data.data.count;
                    console.log('🔢 Contador del carrito actualizado:', data.data.count);
                }
            }
            
        } else {
            console.error('❌ Error del servidor:', data.data);
            
            // Revertir cambio visual
            quantityElement.textContent = currentQty;
            quantityElement.style.background = '#fee2e2';
            quantityElement.style.color = '#dc2626';
            
            showNotification('❌ Error: ' + (data.data || 'Error desconocido'), 'error');
            
            setTimeout(() => {
                quantityElement.style.background = '#f9fafb';
                quantityElement.style.color = '#1f2937';
            }, 3000);
        }
    })
    .catch(error => {
        clearTimeout(timeoutId);
        console.error('❌ Error AJAX:', error);
        
        // Revertir cambio visual
        quantityElement.textContent = currentQty;
        quantityElement.style.background = '#fee2e2';
        quantityElement.style.color = '#dc2626';
        
        let errorMessage = 'Error de conexión';
        if (error.name === 'AbortError') {
            errorMessage = 'Timeout: La petición tardó demasiado';
        } else if (error.message) {
            errorMessage = error.message;
        }
        
        showNotification('❌ ' + errorMessage, 'error');
        
        setTimeout(() => {
            quantityElement.style.background = '#f9fafb';
            quantityElement.style.color = '#1f2937';
        }, 3000);
    })
    .finally(() => {
        // Rehabilitar botones SIEMPRE
        allButtons.forEach(btn => {
            btn.disabled = false;
            btn.style.opacity = '1';
            btn.style.cursor = 'pointer';
        });
        console.log('🔓 Botones rehabilitados');
    });
}

// Función SUPER ROBUSTA para eliminar producto
function removeItem(cartKey) {
    console.log('🗑️ removeItem iniciado:', cartKey);
    
    if (!confirm('¿Estás seguro de eliminar este producto del carrito?')) {
        console.log('❌ Usuario canceló eliminación');
        return;
    }
    
    // Verificar variables globales
    if (!AJAX_URL || !CART_NONCE) {
        console.error('❌ Variables globales no disponibles para eliminar');
        alert('Error: Configuración AJAX no disponible');
        return;
    }
    
    const productElement = document.querySelector(`[data-key="${cartKey}"]`);
    if (!productElement) {
        console.error('❌ No se encontró elemento del producto:', cartKey);
        alert('Error: Producto no encontrado');
        return;
    }
    
    // Deshabilitar todo el producto
    const allButtons = productElement.querySelectorAll('button');
    allButtons.forEach(btn => {
        btn.disabled = true;
        btn.style.opacity = '0.3';
    });
    
    productElement.style.opacity = '0.7';
    productElement.style.pointerEvents = 'none';
    
    showNotification('🗑️ Eliminando producto...', 'info');
    
    // Preparar datos
    const formData = new FormData();
    formData.append('action', 'remove_cart_item');
    formData.append('cart_key', cartKey);
    formData.append('nonce', CART_NONCE);
    
    console.log('📤 Enviando eliminación:', cartKey);
    
    fetch(AJAX_URL, {
        method: 'POST',
        body: formData
    })
    .then(response => {
        console.log('📡 Respuesta eliminar:', response.status);
        return response.text();
    })
    .then(text => {
        console.log('📄 Respuesta eliminar texto:', text.substring(0, 100));
        
        let data;
        try {
            data = JSON.parse(text);
        } catch (parseError) {
            console.error('❌ Error parseando JSON eliminar:', parseError);
            throw new Error('Respuesta no es JSON válido');
        }
        
        if (data.success) {
            console.log('✅ Producto eliminado correctamente');
            showNotification('✅ Producto eliminado del carrito', 'success');
            
            // Animar eliminación
            productElement.style.transition = 'all 0.5s ease';
            productElement.style.transform = 'translateX(-100%)';
            productElement.style.opacity = '0';
            
            setTimeout(() => {
                productElement.remove();
                console.log('🗑️ Elemento removido del DOM');
                
                // Verificar si el carrito está vacío
                const remainingItems = document.querySelectorAll('[data-key]');
                if (remainingItems.length === 0) {
                    console.log('🛒 Carrito vacío, recargando página...');
                    setTimeout(() => location.reload(), 1000);
                }
            }, 500);
            
        } else {
            console.error('❌ Error del servidor eliminando:', data.data);
            showNotification('❌ Error eliminando: ' + (data.data || 'Error desconocido'), 'error');
            
            // Restaurar elemento
            productElement.style.opacity = '1';
            productElement.style.pointerEvents = 'auto';
            allButtons.forEach(btn => {
                btn.disabled = false;
                btn.style.opacity = '1';
            });
        }
    })
    .catch(error => {
        console.error('❌ Error eliminando:', error);
        showNotification('❌ Error de conexión eliminando', 'error');
        
        // Restaurar elemento
        productElement.style.opacity = '1';
        productElement.style.pointerEvents = 'auto';
        allButtons.forEach(btn => {
            btn.disabled = false;
            btn.style.opacity = '1';
        });
    });
}

// Sistema de notificaciones mejorado
function showNotification(message, type = 'info') {
    console.log('📢 Notificación:', message, type);
    
    // Remover notificaciones existentes
    const existingNotifications = document.querySelectorAll('.loscocos-notification');
    existingNotifications.forEach(n => n.remove());
    
    const notification = document.createElement('div');
    notification.className = 'loscocos-notification';
    
    const colors = {
        success: '#10b981',
        error: '#ef4444',
        info: '#3b82f6',
        warning: '#f59e0b'
    };
    
    notification.style.cssText = `
        position: fixed !important;
        top: 20px !important;
        right: 20px !important;
        background: ${colors[type] || colors.info} !important;
        color: white !important;
        padding: 16px 24px !important;
        border-radius: 12px !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
        z-index: 999999 !important;
        font-weight: 600 !important;
        font-size: 14px !important;
        max-width: 350px !important;
        animation: slideInRight 0.3s ease !important;
        border: 2px solid rgba(255,255,255,0.2) !important;
    `;
    
    notification.textContent = message;
    document.body.appendChild(notification);
    
    // Auto-eliminar después de 4 segundos
    setTimeout(() => {
        notification.style.animation = 'slideOutRight 0.3s ease';
        setTimeout(() => {
            if (notification.parentNode) {
                notification.parentNode.removeChild(notification);
            }
        }, 300);
    }, 4000);
}

// Agregar estilos CSS para animaciones
const styleSheet = document.createElement('style');
styleSheet.textContent = `
    @keyframes slideInRight {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }
    @keyframes slideOutRight {
        from { transform: translateX(0); opacity: 1; }
        to { transform: translateX(100%); opacity: 0; }
    }
    
    /* Mejoras visuales para botones */
    button:hover:not(:disabled) {
        transform: scale(1.05) !important;
        transition: all 0.2s ease !important;
    }
    
    button:active:not(:disabled) {
        transform: scale(0.95) !important;
    }
    
    button:disabled {
        cursor: not-allowed !important;
    }
`;
document.head.appendChild(styleSheet);

// Inicialización cuando carga la página
document.addEventListener('DOMContentLoaded', function() {
    console.log('🛒 Carrito Los Cocos completamente cargado');
    console.log('🔧 Configuración:', {
        AJAX_URL: AJAX_URL,
        CART_NONCE: CART_NONCE ? 'Disponible' : 'No disponible'
    });
    
    // Contar productos
    const cartItems = document.querySelectorAll('[data-key]');
    console.log('📦 Productos en carrito:', cartItems.length);
    
    if (cartItems.length > 0) {
        cartItems.forEach((item, index) => {
            const cartKey = item.getAttribute('data-key');
            console.log(`📦 Producto ${index + 1}: ${cartKey}`);
        });
        
        showNotification('🛒 Carrito cargado correctamente', 'success');
    } else {
        console.log('🛒 Carrito vacío');
    }
    
    // Test de funcionalidad (solo en desarrollo)
    if (window.location.hostname === 'localhost') {
        setTimeout(() => {
            console.log('🧪 Modo desarrollo detectado - funciones listas para testing');
        }, 2000);
    }
});

// Función de debug para testing manual
window.debugCartFunctions = function() {
    console.log('🔍 Debug de funciones del carrito:');
    console.log('- AJAX_URL:', AJAX_URL);
    console.log('- CART_NONCE:', CART_NONCE);
    console.log('- Productos:', document.querySelectorAll('[data-key]').length);
    console.log('- updateQuantity: disponible');
    console.log('- removeItem: disponible');
    console.log('- showNotification: disponible');
    
    showNotification('🔍 Funciones de debug ejecutadas - ver consola', 'info');
};

console.log('✅ JavaScript del carrito completamente inicializado');
console.log('💡 Tip: Ejecuta debugCartFunctions() en la consola para debug');
</script>

