/**
 * AJAX handler for removing items from cart
 */
function loscocos_ajax_remove_from_cart() {
    check_ajax_referer('loscocos-nonce', 'nonce');
    
    $cart_item_key = isset($_POST['cart_item_key']) ? wc_clean($_POST['cart_item_key']) : '';
    
    if (empty($cart_item_key)) {
        wp_send_json_error('Clave de artículo del carrito no válida');
        return;
    }
    
    // Remove item from cart
    $removed = WC()->cart->remove_cart_item($cart_item_key);
    
    if ($removed) {
        // Get updated cart fragments
        $fragments = array();
        
        // Get mini cart
        ob_start();
        woocommerce_mini_cart();
        $mini_cart = ob_get_clean();
        
        $fragments['div.widget_shopping_cart_content'] = '<div class="widget_shopping_cart_content">' . $mini_cart . '</div>';
        
        // Cart hash
        $fragments['cart_hash'] = WC()->cart->get_cart_hash();
        
        // Cart items count
        $fragments['cart_count'] = WC()->cart->get_cart_contents_count();
        
        wp_send_json_success(array(
            'message' => 'Producto eliminado del carrito',
            'fragments' => $fragments,
            'cart_hash' => WC()->cart->get_cart_hash(),
            'cart_count' => WC()->cart->get_cart_contents_count(),
            'subtotal' => WC()->cart->get_cart_subtotal()
        ));
    } else {
        wp_send_json_error('No se pudo eliminar el producto del carrito');
    }
}

/**
 * AJAX handler for getting cart count
 */
function loscocos_ajax_get_cart_count() {
    // No necesita nonce para solo obtener el contador
    
    $cart_count = WC()->cart->get_cart_contents_count();
    $cart_total = WC()->cart->get_cart_total();
    $cart_subtotal = WC()->cart->get_cart_subtotal();
    
    wp_send_json_success(array(
        'cart_count' => $cart_count,
        'cart_total' => $cart_total,
        'cart_subtotal' => $cart_subtotal,
        'cart_hash' => WC()->cart->get_cart_hash()
    ));
}

// =================================================================================
// ASEGURAR QUE JQUERY ESTÉ CARGADO
// =================================================================================

function loscocos_enqueue_jquery() {
    if (!wp_script_is('jquery', 'enqueued')) {
        wp_enqueue_script('jquery');
    }
}
add_action('wp_enqueue_scripts', 'loscocos_enqueue_jquery', 1);

// Redirect uncategorized category to shop
function loscocos_redirect_uncategorized() {
    if (is_product_category('uncategorized')) {
        wp_redirect(wc_get_page_permalink('shop'));
        exit;
    }
}
add_action('template_redirect', 'loscocos_redirect_uncategorized');

// =================================================================================
// MEJORAR EL HANDLER DE updateQuantity
// =================================================================================

// Crear alias para el handler de updateQuantity
function loscocos_update_cart_handler() {
    loscocos_ajax_update_cart();
}

